# ==== Data (large / generated) ====
# Keep folder structure via .gitkeep; ignore every other file under these dirs.
data/raw/*
data/processed/*
data/eval/*.parquet
data/eval/*.jsonl
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/eval/.gitkeep

