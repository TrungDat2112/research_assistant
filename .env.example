# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ---- LLM provider (Anthropic / Claude) ---------------------------------
# ADR-008: Planner+Critic = Sonnet 4.5, Synthesizer = Haiku.
ANTHROPIC_API_KEY=sk-ant-xxxx

# Override model ids if needed (defaults are set in config.py).
# ANTHROPIC_PLANNER_MODEL=claude-sonnet-4-5
# ANTHROPIC_SYNTHESIZER_MODEL=claude-haiku-4-5

# ---- Web search (Tavily) ------------------------------------------------
# https://tavily.com/
TAVILY_API_KEY=tvly-xxxx

# ---- Observability (Langfuse Cloud, ADR-009) ----------------------------
# https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Budget guardrails (ADR-011) ----------------------------------------
# Hard total budget across dev/test (USD).
MAX_BUDGET_USD=10.0
# Alert threshold (USD); log warning when accumulated cost crosses this.
BUDGET_ALERT_USD=7.0
# Per-query hard cap (USD); refuse to continue a single query past this.
PER_QUERY_CAP_USD=0.30

# ---- RAG — embeddings (ADR-013 / ADR-018) -------------------------------
# Default in config is BAAI/bge-m3 (multilingual, ~2.3 GB). For a faster
# English-only dev loop, uncomment:
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DEVICE=cpu

# ---- RAG — stage-2 rerank (BAAI/bge-reranker-v2-m3) ----------------------
# RERANKER_ENABLED=true
# RERANKER_DEVICE=cpu
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# How many web+corpus hits to merge before re-rank; Synthesizer sees top 5 by default.
# RETRIEVAL_CANDIDATE_POOL=20
# SYNTHESIZER_EVIDENCE_TOP_K=5

# ---- Critic (PLAN §6.2 / ADR-005) ---------------------------------------
# CRITIC_ENABLED=true
# Max synthesis rounds per sub-question (initial attempt + retries).
# CRITIC_MAX_ATTEMPTS_PER_SUB_QUESTION=2
# CRITIC_MIN_PARAGRAPH_CITATION_COVERAGE=0.9

# ---- Runtime ------------------------------------------------------------
# ReAct loop safety cap.
MAX_ITERATIONS=8
# Default output language for reports (ADR-007).
OUTPUT_LANGUAGE=vi
# LOG_LEVEL=INFO
